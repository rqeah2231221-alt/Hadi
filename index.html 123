
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0a0a0a">
<meta name="description" content="H GAME - لعبة دمج وتطوير العناصر الذهبية وبناء إمبراطوريتك الملكية.">
<title>H GAME | Royal Merge Tycoon</title>
<style>
:root {
  --bg:#0a0a0a; --panel:#141414; --panel2:#1c1a13;
    --gold:#d4af37; --bright:#ffd700; --text:#f7f0d0;
      --muted:#9a927b; --border:#493b17; --green:#85d6a0;
      }
      *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
      html{background:var(--bg);min-height:100%;overscroll-behavior:none}
      body{
        margin:0;background:radial-gradient(ellipse at top,#242014 0,#101010 42%,#080808 100%);
          color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
            min-height:100dvh;touch-action:pan-y;
            }
            button{font:inherit;cursor:pointer;color:inherit}
            button:focus-visible{outline:2px solid var(--bright);outline-offset:3px}
            .app{width:100%;max-width:540px;margin:auto;padding:12px 13px calc(22px + env(safe-area-inset-bottom))}
            header{text-align:center;padding:13px 0 17px}
            .crown{font-size:31px;filter:drop-shadow(0 0 9px #d4af3780)}
            .brand{
              margin:2px 0;font-size:clamp(31px,8vw,43px);font-weight:1000;
                letter-spacing:5px;direction:ltr;
                  background:linear-gradient(180deg,#fff3a5,#ffd700 42%,#a57812);
                    color:transparent;background-clip:text;-webkit-background-clip:text;
                      text-shadow:0 0 22px #d4af3730;
                      }
                      .tagline{font-size:10px;letter-spacing:3px;color:var(--muted);direction:ltr}
                      .stats{display:grid;grid-template-columns:1.2fr 1fr 0.8fr;gap:7px;margin-bottom:13px}
                      .stat{
                        background:linear-gradient(145deg,#1b1a16,#101010);
                          border:1px solid var(--border);border-radius:13px;padding:11px 5px;text-align:center;
                            min-width:0;box-shadow:inset 0 1px #ffffff08;
                            }
                            .stat-label{font-size:10px;color:var(--muted);margin-bottom:6px}
                            .stat-value{font-size:clamp(13px,3.5vw,18px);font-weight:850;color:var(--bright);overflow-wrap:anywhere}
                            .stat-sub{font-size:9px;color:#9a927b;margin-top:4px}
                            .panel{
                              background:linear-gradient(150deg,#19170f,#111 70%);
                                border:1px solid var(--border);border-radius:17px;padding:13px;margin-bottom:12px;
                                }
                                .section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:11px}
                                .section-title{font-size:14px;font-weight:800}
                                .pill{font-size:10px;color:var(--gold);border:1px solid #6b5421;border-radius:30px;padding:5px 9px;white-space:nowrap}
                                .progress-wrap{height:4px;background:#29251a;border-radius:5px;margin-top:8px;overflow:hidden}
                                .progress{height:100%;width:0;background:linear-gradient(90deg,#ad8419,#ffe66d);transition:width .3s}
                                .grid{
                                  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;
                                    direction:ltr;touch-action:pan-y;
                                    }
                                    .cell{
                                      aspect-ratio:1;min-width:0;position:relative;border:1px solid #39301a;border-radius:12px;
                                        background:linear-gradient(145deg,#1b1a17,#111);
                                          display:flex;align-items:center;justify-content:center;flex-direction:column;
                                            transition:border-color .15s,transform .15s,background .15s;
                                              overflow:hidden;user-select:none;touch-action:pan-y;
                                              }
                                              .cell:empty::after{content:"+";color:#574b2b;font-size:19px;font-weight:300}
                                              .cell.filled{background:radial-gradient(circle at 50% 30%,#342a12,#191711 75%)}
                                              .cell.selected{border:2px solid var(--bright);box-shadow:0 0 15px #ffd70036}
                                              .cell.drag-over{border:2px dashed var(--bright);background:#332b12}
                                              .cell .emoji{font-size:clamp(27px,8vw,39px);line-height:1.2;filter:drop-shadow(0 3px 5px #0008);pointer-events:none}
                                              .cell .tier{font-size:9px;color:#d3bd75;margin-top:3px;pointer-events:none}
                                              .cell .mini-income{font-size:8px;color:var(--green);pointer-events:none}
                                              .cell.pop{animation:pop .32s ease}
                                              @keyframes pop{50%{transform:scale(1.09);filter:brightness(1.7)}}
                                              .cell.shake{animation:shake .25s}
                                              @keyframes shake{25%{transform:translateX(3px)}75%{transform:translateX(-3px)}}
                                              .cell .spark{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle,#fff6a8,transparent 70%);animation:spark .5s forwards}
                                              @keyframes spark{to{opacity:0;transform:scale(1.8)}}
                                              .hint{text-align:center;color:var(--muted);font-size:10px;line-height:1.8;margin:10px 0 1px}
                                              .actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px}
                                              .btn{
                                                border:1px solid #745b1b;border-radius:12px;padding:12px 8px;font-size:13px;
                                                  font-weight:800;background:linear-gradient(135deg,#3a2d10,#19150b);
                                                    color:var(--bright);transition:transform .12s,filter .12s;
                                                    }
                                                    .btn:active{transform:scale(.97);filter:brightness(1.3)}
                                                    .btn.primary{background:linear-gradient(135deg,#f6d66b,#b68a20);color:#171105;border:0}
                                                    .btn:disabled{opacity:.42;cursor:not-allowed;filter:grayscale(.6)}
                                                    .btn small{display:block;font-size:10px;font-weight:500;margin-top:4px;opacity:.8}
                                                    .tabs{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px}
                                                    .tab{background:#111;border:1px solid #38301d;border-radius:10px;padding:11px;font-size:12px;color:var(--muted)}
                                                    .tab.active{border-color:var(--gold);color:var(--bright);background:#282111}
                                                    .shop{display:none}
                                                    .shop.active{display:block}
                                                    .upgrade{
                                                      display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #ffffff0b;
                                                      }
                                                      .upgrade:last-child{border-bottom:0}
                                                      .up-icon{font-size:26px;width:38px;text-align:center;flex-shrink:0}
                                                      .up-info{flex:1;min-width:0}
                                                      .up-name{font-size:12px;font-weight:800}
                                                      .up-desc{font-size:10px;color:var(--muted);margin-top:4px;line-height:1.6}
                                                      .buy{padding:9px 10px;border-radius:9px;border:1px solid #80651e;background:#241d0d;color:var(--bright);font-size:10px;font-weight:800;min-width:82px}
                                                      .buy:disabled{opacity:.4}
                                                      .collection{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
                                                      .collect-item{border:1px solid #332c1c;background:#111;border-radius:10px;padding:10px 3px;text-align:center;min-width:0}
                                                      .collect-item .emoji{font-size:25px}
                                                      .collect-item .name{font-size:10px;margin-top:5px}
                                                      .collect-item .rate{font-size:9px;color:var(--green);margin-top:4px}
                                                      .collect-item.locked{filter:grayscale(1);opacity:.35}
                                                      footer{text-align:center;padding:15px 0 5px;color:#625a46;font-size:9px;letter-spacing:1px;direction:ltr}
                                                      #toast{
                                                        position:fixed;z-index:20;top:calc(12px + env(safe-area-inset-top));left:50%;
                                                          transform:translate(-50%,-150%);width:max-content;max-width:90%;
                                                            background:#211b0d;border:1px solid var(--gold);border-radius:12px;
                                                              padding:12px 16px;text-align:center;font-size:12px;color:var(--bright);
                                                                box-shadow:0 8px 30px #0009;transition:transform .3s;pointer-events:none;
                                                                }
                                                                #toast.show{transform:translate(-50%,0)}
                                                                .overlay{
                                                                  position:fixed;inset:0;background:#000c;z-index:30;display:none;
                                                                    align-items:center;justify-content:center;padding:20px;
                                                                    }
                                                                    .overlay.show{display:flex}
                                                                    .modal{
                                                                      width:100%;max-width:360px;text-align:center;padding:25px 20px;
                                                                        border:1px solid var(--gold);border-radius:20px;
                                                                          background:radial-gradient(ellipse at top,#302713,#121212 75%);
                                                                            box-shadow:0 0 45px #d4af3720;
                                                                            }
                                                                            .modal-icon{font-size:45px}
                                                                            .modal h2{font-size:21px;color:var(--bright);margin:12px 0}
                                                                            .modal p{font-size:13px;line-height:1.9;color:#d4c9a7}
                                                                            .modal .btn{width:100%;margin-top:12px}
                                                                            .muted{color:var(--muted)}
                                                                            @media(min-width:500px){.app{padding-top:20px}.panel{padding:16px}.grid{gap:9px}.cell{border-radius:14px}}
                                                                            @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
                                                                            </style>
                                                                            </head>
                                                                            <body>
                                                                            <div class="app">
                                                                            <header>
                                                                              <div class="crown">♛</div>
                                                                                <div class="brand">H GAME</div>
                                                                                  <div class="tagline">ROYAL MERGE TYCOON</div>
                                                                                  </header>

                                                                                  <section class="stats" aria-label="إحصائيات اللعبة">
                                                                                    <div class="stat">
                                                                                        <div class="stat-label">🪙 الرصيد الذهبي</div>
                                                                                            <div class="stat-value" id="gold">100</div>
                                                                                                <div class="stat-sub">GOLD COINS</div>
                                                                                                  </div>
                                                                                                    <div class="stat">
                                                                                                        <div class="stat-label">⚡ الدخل / ثانية</div>
                                                                                                            <div class="stat-value" id="gps">0</div>
                                                                                                                <div class="stat-sub">PASSIVE INCOME</div>
                                                                                                                  </div>
                                                                                                                    <div class="stat">
                                                                                                                        <div class="stat-label">👑 المستوى</div>
                                                                                                                            <div class="stat-value" id="level">1</div>
                                                                                                                                <div class="stat-sub" id="xpText">0 XP</div>
                                                                                                                                  </div>
                                                                                                                                  </section>

                                                                                                                                  <section class="panel">
                                                                                                                                    <div class="section-head">
                                                                                                                                        <div class="section-title">👑 ساحة التطوير الملكية</div>
                                                                                                                                            <div class="pill" id="boardCount">0 / 16</div>
                                                                                                                                              </div>
                                                                                                                                                <div class="section-head" style="margin-bottom:0">
                                                                                                                                                    <span class="muted" style="font-size:10px">التقدم نحو المستوى التالي</span>
                                                                                                                                                        <span id="levelProgressText" class="pill">0%</span>
                                                                                                                                                          </div>
                                                                                                                                                            <div class="progress-wrap"><div class="progress" id="levelProgress"></div></div>
                                                                                                                                                              <div class="grid" id="grid" style="margin-top:13px" aria-label="شبكة دمج العناصر"></div>
                                                                                                                                                                <p class="hint">اختر عنصرين متطابقين لدمجهما، أو اسحب عنصراً فوق آخر.<br>كلما ارتقى العنصر، زاد دخلك الذهبي.</p>
                                                                                                                                                                </section>

                                                                                                                                                                <div class="actions">
                                                                                                                                                                  <button class="btn primary" id="spawnBtn">＋ توليد عنصر<small id="spawnCost">التكلفة: 25 ذهب</small></button>
                                                                                                                                                                    <button class="btn" id="soundBtn">🔊 الصوت: مفعّل<small>المؤثرات الملكية</small></button>
                                                                                                                                                                    </div>

                                                                                                                                                                    <div class="tabs">
                                                                                                                                                                      <button class="tab active" data-tab="shop">🛒 المتجر والترقيات</button>
                                                                                                                                                                        <button class="tab" data-tab="collection">💎 مجموعة العناصر</button>
                                                                                                                                                                        </div>

                                                                                                                                                                        <section class="panel shop active" id="shop">
                                                                                                                                                                          <div class="section-head">
                                                                                                                                                                              <div class="section-title">⚒️ تطوير الإمبراطورية</div>
                                                                                                                                                                                  <span class="pill">UPGRADES</span>
                                                                                                                                                                                    </div>
                                                                                                                                                                                      <div id="upgradeList"></div>
                                                                                                                                                                                      </section>

                                                                                                                                                                                      <section class="panel shop" id="collection">
                                                                                                                                                                                        <div class="section-head">
                                                                                                                                                                                            <div class="section-title">💎 موسوعة التطور</div>
                                                                                                                                                                                                <span class="pill">6 TIERS</span>
                                                                                                                                                                                                  </div>
                                                                                                                                                                                                    <div class="collection" id="collectionList"></div>
                                                                                                                                                                                                    </section>

                                                                                                                                                                                                    <section class="panel">
                                                                                                                                                                                                      <div class="section-head">
                                                                                                                                                                                                          <div class="section-title">📊 سجل الإمبراطورية</div>
                                                                                                                                                                                                            </div>
                                                                                                                                                                                                              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                                                                                                                                                                                                                  <div><div class="stat-label">إجمالي الدمج</div><div id="merges" class="stat-value">0</div></div>
                                                                                                                                                                                                                      <div><div class="stat-label">إجمالي الأرباح</div><div id="earned" class="stat-value">0</div></div>
                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                        </section>

                                                                                                                                                                                                                        <footer>H GAME · ROYAL EDITION · MADE FOR YOU</footer>
                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                        <div id="toast" role="status" aria-live="polite"></div>

                                                                                                                                                                                                                        <div class="overlay" id="welcome">
                                                                                                                                                                                                                          <div class="modal">
                                                                                                                                                                                                                              <div class="modal-icon">👑</div>
                                                                                                                                                                                                                                  <h2>مرحباً بعودتك!</h2>
                                                                                                                                                                                                                                      <p>استمرت إمبراطوريتك الملكية في إنتاج الذهب أثناء غيابك.</p>
                                                                                                                                                                                                                                          <div style="font-size:26px;font-weight:900;color:var(--bright);margin:12px 0" id="offlineAmount">+0 ذهب</div>
                                                                                                                                                                                                                                              <p class="muted" id="offlineTime"></p>
                                                                                                                                                                                                                                                  <button class="btn primary" id="collectBtn">استلام الأرباح ومتابعة اللعب</button>
                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                    <script>
                                                                                                                                                                                                                                                    (() => {
                                                                                                                                                                                                                                                    'use strict';
      try {

                                                                                                                                                                                                                                                    const SAVE_KEY = 'h_game_royal_v1';
                                                                                                                                                                                                                                                    const MAX_OFFLINE_SECONDS = 8 * 60 * 60;
                                                                                                                                                                                                                                                    const tiers = [
                                                                                                                                                                                                                                                      {name:'عملة ذهبية',emoji:'🪙',income:0.2},
                                                                                                                                                                                                                                                        {name:'خاتم فضي',emoji:'💍',income:1},
                                                                                                                                                                                                                                                          {name:'تاج ذهبي',emoji:'👑',income:5},
                                                                                                                                                                                                                                                            {name:'جوهرة ألماس',emoji:'💎',income:25},
                                                                                                                                                                                                                                                              {name:'سيارة فاخرة',emoji:'🏎️',income:125},
                                                                                                                                                                                                                                                                {name:'الخزنة الملكية',emoji:'🏦',income:625}
                                                                                                                                                                                                                                                                ];

                                                                                                                                                                                                                                                                const $ = id => document.getElementById(id);
                                                                                                                                                                                                                                                                const gridEl = $('grid');
                                                                                                                                                                                                                                                                let state;
                                                                                                                                                                                                                                                                let soundEnabled = true;
                                                                                                                                                                                                                                                                let audioContext = null;
                                                                                                                                                                                                                                                                let toastTimer = null;
                                                                                                                                                                                                                                                                let selected = null;
                                                                                                                                                                                                                                                                let dragFrom = null;
                                                                                                                                                                                                                                                                let lastFrame = 0;
                                                                                                                                                                                                                                                                let saveTimer = 0;
                                                                                                                                                                                                                                                                let autoTimer = 0;
                                                                                                                                                                                                                                                                let offlineReward = 0;
                                                                                                                                                                                                                                                                let toastQueue = [];

                                                                                                                                                                                                                                                                function freshState(){
                                                                                                                                                                                                                                                                  return {
                                                                                                                                                                                                                                                                      gold:100, board:Array(16).fill(0), level:1, xp:0,
                                                                                                                                                                                                                                                                          merges:0, totalEarned:0, spawnLevel:0, autoLevel:0,
                                                                                                                                                                                                                                                                              multiplierLevel:0, lastTime:Date.now(), unlocked:[1],
                                                                                                                                                                                                                                                                                  pendingOffline:0
                                                                                                                                                                                                                                                                                    };
                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                    function loadGame(){
                                                                                                                                                                                                                                                                                      try {
                                                                                                                                                                                                                                                                                          const raw = localStorage.getItem(SAVE_KEY);
                                                                                                                                                                                                                                                                                              if(!raw) return freshState();
                                                                                                                                                                                                                                                                                                  const data = JSON.parse(raw);
                                                                                                                                                                                                                                                                                                      const s = freshState();
                                                                                                                                                                                                                                                                                                          if(!data || !Array.isArray(data.board) || data.board.length !== 16) return s;
                                                                                                                                                                                                                                                                                                              Object.assign(s,data);
                                                                                                                                                                                                                                                                                                                  s.board = data.board.map(v => Number.isInteger(v) && v >= 0 && v <= 6 ? v : 0);
                                                                                                                                                                                                                                                                                                                      s.gold = Math.max(0,Number(s.gold)||0);
                                                                                                                                                                                                                                                                                                                          s.level = Math.max(1,Number(s.level)||1);
                                                                                                                                                                                                                                                                                                                              s.xp = Math.max(0,Number(s.xp)||0);
                                                                                                                                                                                                                                                                                                                                  s.merges = Math.max(0,Number(s.merges)||0);
                                                                                                                                                                                                                                                                                                                                      s.totalEarned = Math.max(0,Number(s.totalEarned)||0);
                                                                                                                                                                                                                                                                                                                                          s.spawnLevel = Math.max(0,Math.min(50,Number(s.spawnLevel)||0));
                                                                                                                                                                                                                                                                                                                                              s.autoLevel = Math.max(0,Math.min(10,Number(s.autoLevel)||0));
                                                                                                                                                                                                                                                                                                                                                  s.multiplierLevel = Math.max(0,Math.min(20,Number(s.multiplierLevel)||0));
                                                                                                                                                                                                                                                                                                                                                      s.lastTime = Number(s.lastTime)||Date.now();
                                                                                                                                                                                                                                                                                                                                                          s.pendingOffline = 0;
                                                                                                                                                                                                                                                                                                                                                              return s;
                                                                                                                                                                                                                                                                                                                                                                } catch(e) {
                                                                                                                                                                                                                                                                                                                                                                    return freshState();
                                                                                                                                                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                                                                                                                                                      function saveGame(){
                                                                                                                                                                                                                                                                                                                                                                        try {
                                                                                                                                                                                                                                                                                                                                                                            state.lastTime = Date.now();
                                                                                                                                                                                                                                                                                                                                                                                localStorage.setItem(SAVE_KEY,JSON.stringify(state));
                                                                                                                                                                                                                                                                                                                                                                                  } catch(e) {
                                                                                                                                                                                                                                                                                                                                                                                      showToast('تعذّر الحفظ المحلي. تحقق من مساحة التخزين.');
                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                        function incomePerSecond(){
                                                                                                                                                                                                                                                                                                                                                                                          return state.board.reduce((sum,tier) => sum + (tier ? tiers[tier-1].income : 0),0)
                                                                                                                                                                                                                                                                                                                                                                                              * (1 + state.multiplierLevel * 0.25);
                                                                                                                                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                                                                                                                              function fmt(n){
                                                                                                                                                                                                                                                                                                                                                                                                if(!Number.isFinite(n)) return '0';
                                                                                                                                                                                                                                                                                                                                                                                                  if(n >= 1e9) return (n/1e9).toFixed(2)+'B';
                                                                                                                                                                                                                                                                                                                                                                                                    if(n >= 1e6) return (n/1e6).toFixed(2)+'M';
                                                                                                                                                                                                                                                                                                                                                                                                      if(n >= 1e4) return (n/1e3).toFixed(1)+'K';
                                                                                                                                                                                                                                                                                                                                                                                                        return n.toLocaleString('en-US',{maximumFractionDigits:1});
                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                        function xpNeeded(){
                                                                                                                                                                                                                                                                                                                                                                                                          return state.level * 100;
                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                          function addXP(amount){
                                                                                                                                                                                                                                                                                                                                                                                                            state.xp += amount;
                                                                                                                                                                                                                                                                                                                                                                                                              while(state.xp >= xpNeeded()){
                                                                                                                                                                                                                                                                                                                                                                                                                  state.xp -= xpNeeded();
                                                                                                                                                                                                                                                                                                                                                                                                                      state.level++;
                                                                                                                                                                                                                                                                                                                                                                                                                          state.gold += state.level * 20;
                                                                                                                                                                                                                                                                                                                                                                                                                              showToast('🎉 ارتقيت إلى المستوى '+state.level+'! مكافأة '+fmt(state.level*20)+' ذهب');
                                                                                                                                                                                                                                                                                                                                                                                                                                  playSound(740);
                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                    function playSound(freq=560){
                                                                                                                                                                                                                                                                                                                                                                                                                                      if(!soundEnabled) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                        try{
                                                                                                                                                                                                                                                                                                                                                                                                                                            audioContext = audioContext || new (window.AudioContext || window.webkitAudioContext)();
                                                                                                                                                                                                                                                                                                                                                                                                                                                if(audioContext.state === 'suspended') audioContext.resume();
                                                                                                                                                                                                                                                                                                                                                                                                                                                    const osc = audioContext.createOscillator();
                                                                                                                                                                                                                                                                                                                                                                                                                                                        const gain = audioContext.createGain();
                                                                                                                                                                                                                                                                                                                                                                                                                                                            osc.type = 'sine';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                osc.frequency.setValueAtTime(freq,audioContext.currentTime);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    osc.frequency.exponentialRampToValueAtTime(Math.max(100,freq*0.65),audioContext.currentTime+0.12);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        gain.gain.setValueAtTime(0.08,audioContext.currentTime);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            gain.gain.exponentialRampToValueAtTime(0.001,audioContext.currentTime+0.14);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                osc.connect(gain);gain.connect(audioContext.destination);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    osc.start();osc.stop(audioContext.currentTime+0.15);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }catch(e){}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      function showToast(message){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const el = $('toast');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          el.textContent = message;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            el.classList.add('show');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              clearTimeout(toastTimer);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                toastTimer = setTimeout(()=>el.classList.remove('show'),2400);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function emptyIndex(){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  return state.board.findIndex(v=>v===0);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  function createBoard(){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    gridEl.innerHTML = '';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      state.board.forEach((tier,i)=>{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          const cell = document.createElement('button');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              cell.type = 'button';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  cell.className = 'cell';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      cell.dataset.index = i;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          cell.setAttribute('aria-label','خانة '+(i+1)+(tier ? '، '+tiers[tier-1].name : '، فارغة'));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              cell.addEventListener('click',()=>onCellTap(i));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  cell.addEventListener('pointerdown',e=>{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if(!state.board[i]) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              dragFrom = i;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    try{cell.setPointerCapture(e.pointerId)}catch(err){}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            cell.addEventListener('pointerup',e=>{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(dragFrom === null) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const from = dragFrom;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              dragFrom = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if(from === i) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if(state.board[from]) moveOrMerge(from,i);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  cell.addEventListener('pointercancel',()=>{dragFrom=null});
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      gridEl.appendChild(cell);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          renderBoard();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          function renderBoard(){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            [...gridEl.children].forEach((cell,i)=>{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const tier = state.board[i];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    cell.classList.toggle('filled',tier>0);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        cell.classList.toggle('selected',selected===i);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            cell.innerHTML = '';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if(tier){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const item = tiers[tier-1];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const emoji = document.createElement('span');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  emoji.className = 'emoji';emoji.textContent = item.emoji;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const label = document.createElement('span');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              label.className = 'tier';label.textContent = 'T'+tier;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    const rate = document.createElement('span');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          rate.className = 'mini-income';rate.textContent = '+'+fmt(item.income*(1+state.multiplierLevel*.25))+'/s';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                cell.append(emoji,label,rate);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        $('boardCount').textContent = state.board.filter(Boolean).length+' / 16';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        function onCellTap(i){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if(!state.board[i]){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if(selected !== null){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    selected = null;renderBoard();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if(selected === null){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    selected = i;renderBoard();playSound(440);return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if(selected === i){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            selected = null;renderBoard();return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if(state.board[selected] === state.board[i]){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    merge(selected,i);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          selected = i;renderBoard();playSound(360);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function moveOrMerge(from,to){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if(from===to) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if(!state.board[from]) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(state.board[from]===state.board[to]){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      merge(from,to);return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if(state.board[to]===0){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              state.board[to]=state.board[from];state.board[from]=0;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  selected=null;renderAll();playSound(500);saveGame();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }else{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        selected=to;renderBoard();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            showToast('ادمج عنصرين من المستوى نفسه.');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              function merge(from,to){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const tier=state.board[from];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(!tier || tier!==state.board[to]) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if(tier===6){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        showToast('🏆 وصلت إلى أعلى مستوى! طوّر دخلك في المتجر.');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            selected=null;renderBoard();return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                state.board[to]=tier+1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  state.board[from]=0;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    state.merges++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      state.gold+=tier*10;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        state.totalEarned+=tier*10;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          state.unlocked.push(tier+1);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            addXP(tier*25);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              selected=null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                renderAll();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  const cell=gridEl.children[to];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    cell.classList.add('pop');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const spark=document.createElement('span');spark.className='spark';cell.appendChild(spark);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        setTimeout(()=>{cell.classList.remove('pop');spark.remove()},550);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          playSound(650+tier*100);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            showToast('✨ دمج ناجح! '+tiers[tier].name+' + '+fmt(tier*10)+' ذهب');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              saveGame();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              function spawnItem(free=false){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const index=emptyIndex();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(index<0){showToast('الشبكة ممتلئة! ادمج بعض العناصر أولاً.');return false;}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    const cost=free?0:spawnCost();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      if(state.gold<cost){showToast('رصيدك لا يكفي لتوليد عنصر.');return false;}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        state.gold-=cost;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          // Every fifth spawn upgrade unlocks a tier-2 starting item.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const tier=(state.spawnLevel>=5 && Math.random()<0.20)?2:1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              state.board[index]=tier;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                state.unlocked.push(tier);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  selected=null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    renderAll();playSound(500);saveGame();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      return true;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      function spawnCost(){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return Math.floor(25*Math.pow(1.32,state.spawnLevel));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const upgrades=[
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {id:'spawn',icon:'🪙',name:'توليد مخفّض',desc:'يقلّل تكلفة التوليد بنسبة 8% لكل مستوى.',max:20,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              cost:l=>Math.floor(100*Math.pow(1.7,l))},
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {id:'multiplier',icon:'⚡',name:'مضاعف الدخل',desc:'يزيد دخل جميع العناصر بنسبة 25% لكل مستوى.',max:20,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    cost:l=>Math.floor(150*Math.pow(1.85,l))},
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {id:'auto',icon:'🤖',name:'التوليد التلقائي',desc:'ينشئ عنصراً مجانياً كل فترة، إذا توفرت مساحة.',max:10,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          cost:l=>Math.floor(400*Math.pow(2.1,l))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          ];

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          function upgradeLevel(id){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if(id==='spawn')return state.spawnLevel;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if(id==='multiplier')return state.multiplierLevel;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return state.autoLevel;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function upgradeCost(up){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  return up.cost(upgradeLevel(up.id));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  function buyUpgrade(id){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    const up=upgrades.find(x=>x.id===id);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      if(!up)return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const level=upgradeLevel(id);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if(level>=up.max){showToast('وصلت إلى الحد الأقصى لهذه الترقية.');return;}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const cost=upgradeCost(up);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if(state.gold<cost){showToast('رصيد الذهب غير كافٍ.');return;}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                state.gold-=cost;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(id==='spawn')state.spawnLevel++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if(id==='multiplier')state.multiplierLevel++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      if(id==='auto')state.autoLevel++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        playSound(720);renderAll();saveGame();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          showToast('تم شراء الترقية بنجاح!');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          function renderShop(){
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            $('upgradeList').innerHTML='';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              upgrades.forEach(up=>{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  const level=upgradeLevel(up.id);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const max=level>=up.max;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          const cost=upgradeCost(up);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const row=document.createElement('div');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  row.className='upgrade';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const icon = document.createElement('div');
            const info = document.createElement('div');
            info.className = 'up-info';
            const name = document.createElement('div');
            name.className = 'up-name';
            name.textContent = up.icon + ' ' + up.name + ' · المستوى ' + level + '/' + up.max;
            const desc = document.createElement('div');
            desc.className = 'up-desc';
            desc.textContent = up.desc;
            info.append(name, desc);
            const buy = document.createElement('button');
            buy.type = 'button';
            buy.className = 'buy';
            buy.textContent = max ? 'مكتمل' : 'شراء · ' + fmt(cost);
            buy.disabled = max || state.gold < cost;
            buy.addEventListener('click', () => buyUpgrade(up.id));
            row.append(icon, info, buy);
            $('upgradeList').appendChild(row);
          });
        }

        function renderCollection(){
          $('collectionList').innerHTML = '';
          tiers.forEach((item, index) => {
            const tier = index + 1;
            const unlocked = state.unlocked.includes(tier) || state.board.includes(tier);
            const card = document.createElement('div');
            card.className = 'collect-item' + (unlocked ? '' : ' locked');
            const emoji = document.createElement('div');
            emoji.className = 'emoji';
            emoji.textContent = unlocked ? item.emoji : '🔒';
            const name = document.createElement('div');
            name.className = 'name';
            name.textContent = unlocked ? item.name : 'عنصر مقفل';
            const rate = document.createElement('div');
            rate.className = 'rate';
            rate.textContent = unlocked ? '+' + fmt(item.income) + ' ذهب/ث' : 'اكتشفه بالدمج';
            card.append(emoji, name, rate);
            $('collectionList').appendChild(card);
          });
        }

        function renderAll(){
          $('gold').textContent = fmt(state.gold);
          $('gps').textContent = fmt(incomePerSecond());
          $('level').textContent = fmt(state.level);
          $('xpText').textContent = fmt(state.xp) + ' XP';
          $('merges').textContent = fmt(state.merges);
          $('earned').textContent = fmt(state.totalEarned);
          $('spawnCost').textContent = 'التكلفة: ' + fmt(spawnCost()) + ' ذهب';
          $('spawnBtn').disabled = state.gold < spawnCost() || emptyIndex() < 0;
          const progress = Math.min(100, state.xp / xpNeeded() * 100);
          $('levelProgress').style.width = progress + '%';
          $('levelProgressText').textContent = Math.floor(progress) + '%';
          renderBoard();
          renderShop();
          renderCollection();
        }

        function switchTab(tabName){
          document.querySelectorAll('[data-tab]').forEach(button => {
            const active = button.dataset.tab === tabName;
            button.classList.toggle('active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          $('shop').classList.toggle('active', tabName === 'shop');
          $('collection').classList.toggle('active', tabName === 'collection');
        }

        $('spawnBtn').addEventListener('click', () => spawnItem());
        $('soundBtn').addEventListener('click', () => {
          soundEnabled = !soundEnabled;
          $('soundBtn').innerHTML = (soundEnabled ? '🔊 الصوت: مفعّل' : '🔇 الصوت: متوقف') + '<small>المؤثرات الملكية</small>';
          if(soundEnabled) playSound(560);
        });
        document.querySelectorAll('[data-tab]').forEach(button => {
          button.addEventListener('click', () => switchTab(button.dataset.tab));
        });
        $('collectBtn').addEventListener('click', () => {
          if(offlineReward > 0){
            state.gold += offlineReward;
            state.totalEarned += offlineReward;
            showToast('تم استلام ' + fmt(offlineReward) + ' ذهب من أرباح الغياب.');
          }
          offlineReward = 0;
          $('welcome').classList.remove('show');
          saveGame();
          renderAll();
        });

        // Restore the saved game, then calculate earnings accumulated while away.
        state = loadGame();
        const now = Date.now();
        const elapsedSeconds = Math.max(0, Math.min(MAX_OFFLINE_SECONDS, (now - state.lastTime) / 1000));
        offlineReward = Math.floor(incomePerSecond() * elapsedSeconds);
        $('offlineAmount').textContent = '+' + fmt(offlineReward) + ' ذهب';
        $('offlineTime').textContent = elapsedSeconds > 0
          ? 'مدة الغياب المحتسبة: ' + Math.floor(elapsedSeconds / 60) + ' دقيقة'
          : 'ابدأ اللعب واجمع الذهب وطوّر إمبراطوريتك.';
        if(offlineReward > 0) $('welcome').classList.add('show');

        createBoard();
        switchTab('shop');
        renderAll();

        let lastTick = Date.now();
        let autoElapsed = 0;
        setInterval(() => {
          const tickNow = Date.now();
          const delta = Math.min(5, Math.max(0, (tickNow - lastTick) / 1000));
          lastTick = tickNow;
          const income = incomePerSecond() * delta;
          if(income > 0){
            state.gold += income;
            state.totalEarned += income;
          }
          if(state.autoLevel > 0){
            autoElapsed += delta;
            const interval = Math.max(8, 60 / state.autoLevel);
            if(autoElapsed >= interval){
              autoElapsed = 0;
              spawnItem(true);
            }
          }
          renderAll();
        }, 1000);

        setInterval(saveGame, 10000);
        document.addEventListener('visibilitychange', () => {
          if(document.visibilityState === 'hidden') saveGame();
        });
        window.addEventListener('pagehide', saveGame);
      } catch(error) {
        console.error('H GAME startup error:', error);
        const toast = document.getElementById('toast');
        if(toast){
          toast.textContent = 'حدث خطأ في تشغيل اللعبة. أعد تحميل الصفحة.';
          toast.classList.add('show');
        }
      }
    })();
    </script>
    </body>
    </html>
